  "narrative": {
    "northStar": "The Outdoor Journal",
    "overview": "Outside pairs warm paper and pine ink with an open editorial rhythm. A calm serif voice gives the page personality; straightforward controls and aligned hourly values keep decisions easy to inspect. Forecast data supplies the central visual.\n\nThe system is flat and restrained. Sun-yellow geometry adds warmth without competing with the recommendation. Interface labels remain direct, and sample, loading, error and live-data states stay explicit.",
    "keyCharacteristics": [
      "Broad serif headings and compact sans-serif controls.",
      "Warm neutral surfaces with pine emphasis and sparse yellow accents.",
      "Open margins around dense, aligned hourly evidence.",
      "Native interaction, visible focus and textual explanations alongside color."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Color supports a stated result; hourly reasons and status text must carry the meaning independently.",
        "section": "colors"
      },
      {
        "name": "The Data Alignment Rule",
        "body": "Use tabular numerals for hourly values and weather metrics. Preserve units in the surrounding label or table caption.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Establish hierarchy with tone, spacing and type before adding another container.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep editorial headings broad and controls compact.",
      "Do pair hourly colors with inspectable textual reasons.",
      "Do preserve explicit sample, source, loading and error labels.",
      "Do retain visible focus and native keyboard behavior.",
      "Do keep units and dates close to the values they explain."
    ],
    "donts": [
      "Don't replace the flat tonal hierarchy with decorative shadows.",
      "Don't use color alone to communicate forecast checks.",
      "Don't turn scrolling hourly evidence into page-level horizontal overflow.",
      "Don't use text glyphs in place of the SVG icon system.",
      "Don't synthesize an italic or bold Newsreader style from the regular face."
    ]
  }
}
